# OpenAI-compatible chat completion API
API_KEY=replace-with-your-api-key
MODEL=kimi-k2.5
API_BASE=https://api.moonshot.cn/v1

# Enable only when the selected model/API accepts these input parts.
API_IMAGE_INPUT=1
API_AUDIO_INPUT=0

# Local server
HOST=0.0.0.0
PORT=8001

# FunASR aliases use an existing ModelScope cache when available. You can also
# provide absolute local model directories for completely offline startup.
FUNASR_MODEL=paraformer-zh
FUNASR_VAD_MODEL=fsmn-vad
FUNASR_PUNC_MODEL=ct-punc
FUNASR_DEVICE=cpu
