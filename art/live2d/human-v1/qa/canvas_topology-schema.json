            },
            "y": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "minItems": 0,
        "maxItems": 4096
      },
      "edges": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "minItems": 0,
        "maxItems": 65536
      },
      "request_id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "description": "Unique request ID. Retry unchanged arguments with this ID to recover the same result; use a new ID for a new attempt."
      },
      "project_id": {
        "type": "string",
        "minLength": 1,
        "description": "Current project_id from workspace_inspect; null only when no project is loaded."
      }
    },
    "additionalProperties": false,
