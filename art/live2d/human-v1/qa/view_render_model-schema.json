{
  "id": "view_render_model",
  "description": "Evaluate a rig pose, composite selected layers into one PNG, and render only an explicit canvas rectangle or a focused object region. Returns reversible pixel-to-canvas placement metadata. To read coordinates off the reference image for drawing, render a canvas_rect with include_layer_ids [], reference {mode: under, opacity: 1} and grid; outline_material_ids lays drawings over it.",
  "kind": "query",
  "workspace_bound": false,
  "batchable": false,
  "job_backed": false,
  "read_only": true,
  "idempotent": true,
  "destructive": false,
  "request_schema": {
    "type": "object",
    "properties": {
      "annotate_deformer_ids": {
        "type": "array",
        "maxItems": 16,
        "items": {
          "type": "string"
        },
        "description": "Warp IDs: posed lattice, name and stable ID; [] is a clean image"
      },
      "annotate_path_ids": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "string"
        },
        "description": "Deform Path IDs to overlay on the mesh (e.g. ['path_1'] or ['*'] for all paths, or ['L2']/['L3']); [] is a clean image"
      },
      "annotate_path_width": {
        "type": "boolean",
        "default": false,
        "description": "Whether to draw influence width boundaries (outer falloff dashed circle) around deform path control points"
      },
      "annotate_path_hardness": {
        "type": "boolean",
        "default": false,
        "description": "Whether to draw hardness boundaries (inner core solid circle) around deform path control points"
      },
      "annotate_path_radius": {
        "type": "boolean",
        "default": false,
        "description": "Legacy alias for enabling both annotate_path_width and annotate_path_hardness"
      },
      "point_indices": {
        "type": "boolean",
        "default": false
      },
      "reference": {
        "type": "object",
        "additionalProperties": false,
        "description": "Draw the reference image (layout_set_reference) with the model: over it, under it, or difference - black where they match, with referenceDifference the mean difference 0..1 over pixels either covers; opacity overrides the reference's own (over and under)",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "over",
              "under",
              "difference"
            ]
          },
          "opacity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "mode"
        ]
      },
      "density": {
        "type": "boolean",
        "default": false,
        "description": "Texture density heatmap: tint each layer by its texture pixels per canvas unit - blue at 1/4 or less, green at 1, orange at 4 or more - and list them in texelDensity"
      },
      "parameters": {
        "type": "object",
        "description": "Cubism parameter ID to value, for example {ParamAngleX: 10.0}. Omitted parameters render at their defaults, not at the authored pose; read workspace_inspect scope=preview and pass its values to start from it. Rendering never changes the authored pose.",
        "additionalProperties": {
          "type": "number"
        }
      },
      "include_layer_ids": {
        "type": "array",
        "description": "Exact layer IDs to composite. Omit to follow the active canvas's local visibility, so layers the user hid, layers under a hidden deformer and layers outside a solo are missing; pass IDs for a result independent of the canvas. [] renders no model layers.",
        "items": {
          "type": "string"
        }
      },
      "annotate_layer_ids": {
        "type": "array",
        "description": "Layer IDs to label and outline at their deformed positions",
        "items": {
          "type": "string"
        }
      },
      "viewport": {
        "type": "object",
        "description": "Required camera: {mode:canvas_rect,left,top,width,height} or {mode:focus_layers,layer_ids,object_scale,aspect_ratio}",
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "canvas_rect",
              "focus_layers"
            ]
          },
          "left": {
            "type": "number"
          },
          "top": {
            "type": "number"
          },
          "width": {
            "type": "number"
          },
          "height": {
            "type": "number"
          },
          "object_scale": {
            "type": "number"
          },
          "aspect_ratio": {
            "type": "number"
          },
          "layer_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "mode"
        ]
      },
      "background": {
        "type": "string",
        "enum": [
          "transparent",
          "checkerboard"
        ],
        "default": "transparent"
      },
      "target_long_edge": {
        "type": "integer",
        "minimum": 128,
        "maximum": 4096,
        "default": 1024,
        "description": "Requested PNG long edge in pixels; independent of canvas units"
      },
      "max_bytes": {
        "type": "integer",
        "minimum": 65536,
        "maximum": 16777216,
        "default": 4194304
      },
      "grid": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Draw grid lines every so many canvas units, labelled with canvas coordinates along the top and left; a step too fine for the view is coarsened (x2, x5, x10...) and gridStep says the step drawn"
      },
      "outline_material_ids": {
        "type": "array",
        "maxItems": 24,
        "items": {
          "type": "string"
        },
        "description": "Material items with a place on this canvas (drawings from material_draw, crops) whose opaque edge is traced over the view where they sit, each in its own colour with its id; compares a drawing's shape with the reference without placing it"
      }
    },
    "additionalProperties": false,
    "required": [
      "viewport"
    ]
  },
