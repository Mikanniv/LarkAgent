                          "min",
                          "max"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "viewId",
                    "imageRect",
                    "parameters"
                  ]
                },
                "minItems": 1,
                "maxItems": 9
              },
              "revisionId": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "physicsSimulated",
              "comparison",
              "width",
              "height",
              "canvasRect",
              "commonParameters",
              "tiles",
              "revisionId"
            ]
          }
        },
        "required": [
          "ok",
          "operation",
          "data"
        ]
      },
