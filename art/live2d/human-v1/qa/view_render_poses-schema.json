                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": {
                            "type": "number"
                          },
                          "min": {
                            "type": "number"
                          },
                          "max": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
